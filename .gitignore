# Virtual environments
.venv/
venv/
env/

# Python bytecode and type/lint/test caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Build artifacts
dist/
build/
*.egg-info/
*.egg

# Environment and secrets
.env
.env.*
*.pem
secrets/

# Media files (the library lives outside git)
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.m4v
*.mpg
*.mpeg
*.wmv
*.flv
*.ts
*.m2ts

# Metadata caches next to the library (tagger and duration index)
.tv90-cache/
.tv90-metadata-cache.json
*.metadata.json
duration-index.json

# Empty dummy files for the simulate CLI sample library (not real media)
!tests/fixtures/sample_library/*.mp4
