#!/usr/bin/env bash
# Boot helper: after overlay is already off, honour the library flag on real root.
# disable --now during `on` is lost with tmpfs /etc; this disable lands on the card.
set -euo pipefail

LIBRARY="${TV90_LIBRARY_PATH:-/srv/90stv/library}"
FLAG="${LIBRARY}/.tv90-maintenance"

if [[ ! -e "${FLAG}" ]]; then
  # Flag absent: `off` already removed it. Do not stop or disable the TV unit.
  exit 0
fi

if findmnt --mountpoint "${LIBRARY}" >/dev/null 2>&1; then
  mount -o remount,rw "${LIBRARY}"
fi

systemctl disable --now 90stv.service || true

# disable_bootro often fails while overlay is live; retry now that overlay is off.
if command -v raspi-config >/dev/null 2>&1; then
  raspi-config nonint disable_bootro || true
fi
